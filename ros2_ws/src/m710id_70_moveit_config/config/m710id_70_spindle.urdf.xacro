<?xml version="1.0"?>
<robot name="m710id_70_spindle" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- include the macro definition file you edited -->
  <xacro:include filename="$(find m710id_description_spindle)/urdf/m710id_70.urdf.xacro"/>
  <!-- instantiate the robot (pulls in your spindle because it’s inside the macro) -->
  <xacro:m710id_70/>
</robot>
