<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="m710id_70">

    <material name="FANUC_Black">
      <color rgba="0 0 0 1.0"/>
    </material>
    <material name="FANUC_Yellow">
      <color rgba="1.00 0.84 0.01 1.00"/>
    </material>
    <material name="FANUC_Gray">
      <color rgba="0.24 0.25 0.26 1.0"/>
    </material>

    <xacro:property name="l_base" value="0.565"/>
    <xacro:property name="l_1" value="0.150"/>
    <xacro:property name="l_2" value="0.895"/>
    <xacro:property name="l_3" value="0.170"/>
    <xacro:property name="l_4" value="1.045"/>
    <xacro:property name="l_5" value="0.0"/>
    <xacro:property name="l_6" value="0.175"/>

    <xacro:property name="j1_v" value="180"/>
    <xacro:property name="j2_v" value="180"/>
    <xacro:property name="j3_v" value="180"/>
    <xacro:property name="j4_v" value="260"/>
    <xacro:property name="j5_v" value="260"/>
    <xacro:property name="j6_v" value="370"/>

    <xacro:property name="j1_u" value="185"/>
    <xacro:property name="j2_u" value="150"/>
    <xacro:property name="j3_u" value="205"/>
    <xacro:property name="j4_u" value="400"/>
    <xacro:property name="j5_u" value="125"/>
    <xacro:property name="j6_u" value="400"/>

    <xacro:property name="j1_l" value="-185"/>
    <xacro:property name="j2_l" value="-75"/>
    <xacro:property name="j3_l" value="-80.5"/>
    <xacro:property name="j4_l" value="-400"/>
    <xacro:property name="j5_l" value="-125"/>
    <xacro:property name="j6_l" value="-400"/>

    <!-- links -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/visual/base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="FANUC_Gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/collision/base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="J1_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/visual/j1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="FANUC_Yellow"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/collision/j1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="J2_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/visual/j2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="FANUC_Yellow"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/collision/j2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="J3_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/visual/j3.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="FANUC_Yellow"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/collision/j3.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="J4_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/visual/j4.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="FANUC_Yellow"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/collision/j4.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="J5_link">
      <visual>
      	<origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/visual/j5.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="FANUC_Yellow"/>
      </visual>
      <collision>
	    <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/collision/j5.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="J6_link">
      <visual>
	    <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/visual/j6.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="FANUC_Black"/>
      </visual>
      <collision>
	    <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/collision/j6.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- joints -->
    <joint name="J1" type="revolute">
      <origin xyz="0 0 ${l_base}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="J1_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="${j1_l * pi / 180}" upper="${j1_u * pi / 180}" effort="0" velocity="${j1_v * pi / 180}"/>
    </joint>

    <joint name="J2" type="revolute">
      <origin xyz="${l_1} 0 0" rpy="0 0 0"/>
      <parent link="J1_link"/>
      <child link="J2_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="${j2_l * pi / 180}" upper="${j2_u * pi / 180}" effort="0" velocity="${j2_v * pi / 180}"/>
    </joint>

    <joint name="J3" type="revolute">
      <origin xyz="0 0 ${l_2}" rpy="0 0 0"/>
      <parent link="J2_link"/>
      <child link="J3_link"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${j3_l * pi / 180}" upper="${j3_u * pi / 180}" effort="0" velocity="${j3_v * pi / 180}"/>
    </joint>

    <joint name="J4" type="revolute">
      <origin xyz="0 0 ${l_3}" rpy="0 0 0"/>
      <parent link="J3_link"/>
      <child link="J4_link"/>
      <axis xyz="-1 0 0"/>
      <limit lower="${j4_l * pi / 180}" upper="${j4_u * pi / 180}" effort="0" velocity="${j4_v * pi / 180}"/>
    </joint>

    <joint name="J5" type="revolute">
      <origin xyz="${l_4} 0 0" rpy="0 0 0"/>
      <parent link="J4_link"/>
      <child link="J5_link"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${j5_l * pi / 180}" upper="${j5_u * pi / 180}" effort="0" velocity="${j5_v * pi / 180}"/>
    </joint>

    <joint name="J6" type="revolute">
      <origin xyz="0 -${l_5} 0" rpy="0 0 0"/>
      <parent link="J5_link"/>
      <child link="J6_link"/>
      <axis xyz="-1 0 0"/>
      <limit lower="${j6_l * pi / 180}" upper="${j6_u * pi / 180}" effort="0" velocity="${j6_v * pi / 180}"/>
    </joint>

    <!-- world coords -->
    <link name="wbase" />
    <joint name="base_link-wbase" type="fixed">
      <origin xyz="0 0 ${l_base}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="wbase"/>
    </joint>

    <!-- flange coords -->
    <link name="flange" />
    <joint name="J6-flange" type="fixed">
      <origin xyz="${l_6} 0 0" rpy="0 0 0" />
      <parent link="J6_link" />
      <child link="flange" />
    </joint>
        <!-- === Spindle (custom end-effector) === -->
    <!-- tune these if you know mass/CoM/inertia -->
    <xacro:property name="spindle_mass" value="2.10"/>
    <xacro:property name="spindle_Ixx"  value="0.002"/>
    <xacro:property name="spindle_Iyy"  value="0.002"/>
    <xacro:property name="spindle_Izz"  value="0.0015"/>

    <!-- If your STL is exported in millimeters, use 0.001 scale -->
    <xacro:property name="spindle_mesh_scale" value="0.001 0.001 0.001"/>

    <!-- If your STL’s tool axis is +Z but FANUC flange points +X, rotate by +90° about Y -->
    <!-- Try rpy="0 ${pi/2} 0"; set to "0 0 0" if your mesh already points +X -->
    <xacro:property name="spindle_mount_rpy" value="0 ${pi/2} 0"/>
    <xacro:property name="spindle_mount_xyz" value="0 0 0"/>

    <!-- TCP offset from spindle_link origin along tool axis (likely +X after the rotation above) -->
    <xacro:property name="spindle_tcp_xyz" value="0.170 0.0 0.12"/>
    <xacro:property name="spindle_tcp_rpy" value="0 0 0"/>

    <link name="spindle_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${spindle_mass}"/>
        <inertia ixx="${spindle_Ixx}" ixy="0" ixz="0" iyy="${spindle_Iyy}" iyz="0" izz="${spindle_Izz}"/>
      </inertial>

      <!-- Visual mesh: point to YOUR copied package & file -->
      <visual>
        <origin xyz="0 0 0" rpy="0 3.14 ${pi/2}"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/visual/spindle.stl"
                scale="${spindle_mesh_scale}"/>
        </geometry>
        <material name="FANUC_Gray"/>
      </visual>

      <!-- Collision mesh (prefer simplified/convex), or reuse visual if needed -->
      <collision>
        <origin xyz="0 0 0" rpy="0 3.14 ${pi/2}"/>
        <geometry>
          <mesh filename="package://m710id_description_spindle/meshes/m710id_70/collision/spindle.stl"
                scale="${spindle_mesh_scale}"/>
        </geometry>
      </collision>
    </link>

    <joint name="spindle_mount" type="fixed">
      <parent link="flange"/>
      <child  link="spindle_link"/>
      <origin xyz="${spindle_mount_xyz}" rpy="${spindle_mount_rpy}"/>
    </joint>

    <link name="spindle_tcp"/>
    <joint name="spindle_tcp_joint" type="fixed">
      <parent link="spindle_link"/>
      <child  link="spindle_tcp"/>
      <origin xyz="${spindle_tcp_xyz}" rpy="${spindle_tcp_rpy}"/>
    </joint>

  </xacro:macro>
</robot>
